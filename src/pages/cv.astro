---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Summary</div>
  </div>

  <div class="mb-10 text-justify">
    Senior Data Engineer with 11+ years of experience designing, developing, and optimizing enterprise data platforms, cloud data architectures, and scalable data solutions.
    Proven ability to lead data architecture initiatives, modernize data platforms, and build reliable data pipelines that enable advanced analytics, business intelligence, and data science.
    Experienced in partnering with stakeholders and clients to translate business requirements into scalable technical solutions and strategic roadmaps.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Senior Data Engineer | Henderson Engineers"
      subtitle="Feb. 2024 to present"
    >
      Spearheaded the development of a new enterprise data platform that focuses on modular data assets instead of monolithic data pipelines.
      Managed the data engineering team responsible for building new data assets and maintaining the enterprise data platform.
    </TimeLineElement>

    <TimeLineElement
      title="Senior Data Engineer | Wavicle Data Solutions"
      subtitle="May 2022 to Feb. 2024"
    >
      Met with current and prospective clients to define business requirements, compare data platform architectures, and develop strategic roadmaps for cloud solution development.
      Conducted architecture assessments for clients, including optimization strategies, improvement recommendations, and potential timelines for implementation.
    </TimeLineElement>

    <TimeLineElement
      title="Data Engineer | Watco Companies"
      subtitle="Feb. 2020 to May 2022"
    >
      Led the design and implementation of a Databricks-focused data platform architecture, providing improved data availability and reduced time to insights for all business users.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="BS, Computer Science"
      subtitle="Aug. 2013 to May 2015 at Truman State University"
    />
    <TimeLineElement
      title="BA, French Language and Literature"
      subtitle="Aug. 2008 to May 2012 at Truman State University"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href="#" target="_blank"> Certified Data Vault 2.0 Practitioner</a>
    </li>
    <li>
      <a href="#" target="_blank"> Astronomer Certification for Apache Airflow Fundamentals</a>
    </li>
    <li>
      <a href="#" target="_blank"> Certification Name (with link)</a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>Python</li>
    <li>R</li>
    <li>SQL</li>
    <li>Azure</li>
    <li>Databricks</li>
    <li>Spark</li>
    <li>Airflow</li>
    <li>Dagster</li>
    <li>dbt</li>
    <li>Docker</li>
    <li>Kubernetes</li>
    <li>CI/CD</li>
    <li>Data Vault</li>
    <li>Data Modeling</li>
    <li>Machine Learning</li>
  </ul>
</BaseLayout>
